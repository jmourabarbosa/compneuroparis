rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Groups: public read, admin full write, creators can update own groups
    match /groups/{groupId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.creatorUid == request.auth.uid
            && request.resource.data.creatorUid == resource.data.creatorUid);
    }

    // Submissions: public create, admin read/write
    match /submissions/{subId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admins: users can check their own admin status, admins can read all and write
    match /admins/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }
  }
}
