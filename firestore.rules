rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Groups (PIs): public read, admin full write, creators and claimedBy users can update own groups
    match /groups/{groupId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.creatorUid == request.auth.uid
            && request.resource.data.creatorUid == resource.data.creatorUid
            && request.resource.data.claimedBy == resource.data.claimedBy)
        || (request.auth != null
            && resource.data.claimedBy == request.auth.uid
            && request.resource.data.creatorUid == resource.data.creatorUid
            && request.resource.data.claimedBy == resource.data.claimedBy);
    }

    // Claims: authenticated create, admin + claimant read, admin update/delete
    match /claims/{claimId} {
      allow create: if request.auth != null;
      allow read: if isAdmin()
        || (request.auth != null && resource.data.claimantUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Submissions: public create, admin read/write
    match /submissions/{subId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Institutes: public read, authenticated create, admin update/delete
    match /institutes/{instId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Reports: anyone can create (no login required), admin read/update/delete
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Contact messages: anyone can create, admin read/update/delete
    match /messages/{msgId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Jobs: public read, authenticated create, poster or admin can update/delete
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin()
        || (request.auth != null && resource.data.postedBy == request.auth.uid);
    }

    // Settings: admin-only read/write
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // Admins: users can check their own admin status, admins can read all and write
    match /admins/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }
  }
}
